# ---- Rotas serverless (Vercel) ----
# Postgres na sua máquina, acessível pela Vercel (host público + SSL)
DATABASE_URL=postgres://agenda:senha@SEU_HOST:5432/agenda?sslmode=require

# Chaves Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Segredo que protege /api/disparar (string longa e aleatória)
DISPARAR_SECRET=

# ---- App (build Vite) ----
VITE_VAPID_PUBLIC_KEY=
VITE_API_BASE=https://SEU-APP.vercel.app

# ---- Dev local (docker-compose) ----
POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=senha
PGADMIN_DEFAULT_EMAIL=admin@exemplo.com
PGADMIN_DEFAULT_PASSWORD=admin
